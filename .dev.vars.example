QQ_BOT_APP_ID=你的QQ开放平台AppID
QQ_BOT_SECRET=你的QQ开放平台AppSecret
QQ_BOT_VERIFY_SIGNATURE=true

# AgnesAI 主模型（免费层）
AGNESAI_API_KEY=你的AgnesAI_API_Key
AGNESAI_BASE_URL=https://apihub.agnes-ai.com/v1
AGNESAI_MODEL=agnes-2.0-flash

# Cloudflare Workers AI 使用原生 AI binding，无需 API Key
# 固定兜底模型：@cf/openai/gpt-oss-120b

AI_MAX_INPUT_TOKENS=8192
YOUTUBE_API_KEY=你的YouTube_Data_API_Key（可选）
