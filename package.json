{
  "name": "qq-bot-cloudflare",
  "version": "1.0.0",
  "description": "QQ Bot + Cloudflare Worker AI Proxy",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --secrets-file .dev.vars",
    "deploy:code": "wrangler deploy",
    "sync:secrets": "node scripts/sync-secrets.mjs",
    "sync:secrets:dry": "node scripts/sync-secrets.mjs --dry-run",
    "build": "npm run typecheck && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.118.0"
  }
}
